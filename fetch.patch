+// Where to put the face-on logo vertically. At full size its top sits on
+// row 1 (row 0 is padding). When a narrow window shrinks the logo, keep its
+// centre where the full-size logo's centre would be, so it shrinks towards
+// the middle instead of hugging the top. Used at startup and on resize, so
+// the result doesn't depend on the size the terminal started at.
+static float logo_y_center(float K1, float K2) {
+  float u0 = 0, d0 = 0; // logo extent above/below centre per unit of K1
+  for (int i = 0; i < POINT_COUNT; i++) {
+    float zc = PZ[i] + K2;
+    if (zc < 0.1f) continue;
+    float ys = PY[i] / zc;
+    if (ys > u0) u0 = ys;
+    if (-ys > d0) d0 = -ys;
+  }
+  float up = K1 * u0, dn = K1 * d0;
+  float kf = 37.0f * full_logo_height / 36.0f * size_scale;
+  float target = 1.0f + kf * (u0 + d0) * 0.5f; // full-size logo's centre row
+  float yc = target + (up - dn) * 0.5f;        // put this logo's centre there
+  if (yc < up + 1.0f)
+    yc = up + 1.0f; // never above row 1
+  return yc;
+}
